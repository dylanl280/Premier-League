{
  "permissions": {
    "allow": [
      "PowerShell(Get-Command python, python3, py, winget -ErrorAction SilentlyContinue)",
      "PowerShell(winget --version)",
      "PowerShell(winget search --id Python.Python.3.13 --exact --source winget)",
      "PowerShell(winget search --id Python.Python --source winget)",
      "PowerShell(winget install --id Python.Python.3.13 --exact --source winget --scope user --silent --accept-package-agreements --accept-source-agreements)",
      "PowerShell($p = \"$env:LOCALAPPDATA\\\\Programs\\\\Python\\\\Python313\\\\python.exe\"; if \\(Test-Path $p\\) { & $p --version; & $p -c \"import sys; print\\(sys.executable\\)\" } else { Write-Output \"not at expected path\" })",
      "PowerShell($u = [Environment]::GetEnvironmentVariable\\(\"Path\",\"User\"\\); \\($u -split ';' | Where-Object { $_ -match 'Python' }\\))",
      "PowerShell($u = [Environment]::GetEnvironmentVariable\\(\"Path\",\"User\"\\); $i = 0; $u -split ';' | Where-Object { $_ } | ForEach-Object { $i++; \"$i`t$_\" })"
    ]
  }
}
