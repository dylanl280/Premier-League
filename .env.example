# Copy to .env and fill in. .env is gitignored.

# Local PostgreSQL instance built by the setup in README.md.
# Port 5433, because 5432 may already be taken by another Postgres.
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=epl

# Optional: only needed if you add a live football data source.
# e.g. https://www.football-data.org/ or API-Football
FOOTBALL_API_KEY=
